# Copy to .env and fill in. .env is git-ignored and excluded from the .vsix.
# Load before publishing:  set -a; source .env; set +a

# Open VSX token — https://open-vsx.org → Settings → Access Tokens
OVSX_PAT=

# VS Code Marketplace PAT (optional) — https://dev.azure.com → Personal access tokens
VSCE_PAT=
